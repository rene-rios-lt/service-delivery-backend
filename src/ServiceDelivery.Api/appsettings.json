{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "dev-secret-change-in-production-at-least-32-chars",
    "Issuer": "ServiceDelivery",
    "Audience": "ServiceDeliveryClient",
    "ExpiryMinutes": 60
  },
  "JobOfferExpiry": {
    "PollIntervalSeconds": 10
  },
  "ReconcilePendingRequests": {
    "PollIntervalSeconds": 30
  },
  "HeartbeatTimeout": {
    "PollIntervalSeconds": 10,
    "TimeoutSeconds": 45
  },
  "Redirect": {
    "CooldownMinutes": 5
  }
}
