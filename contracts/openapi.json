  "components": {
    "schemas": {
      "AcceptJobOfferResult": {
        "required": [
          "offerId",
          "requestId",
          "offerStatus",
          "requestStatus",
          "repState"
        ],
        "type": "object",
        "properties": {
          "offerId": {
            "type": "string",
            "format": "uuid"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "offerStatus": {
            "type": "string"
          },
          "requestStatus": {
            "type": "string"
          },
          "repState": {
            "type": "string"
          }
        }
      },
      "ActiveJobStateDto": {
        "required": [
          "requestId",
          "requesterName",
          "dtcTitle",
          "requesterLat",
          "requesterLng",
          "repLat",
          "repLng",
          "etaMinutes",
          "distanceMiles",
          "tier",
          "repState"
        ],
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "requesterName": {
            "type": "string"
          },
          "dtcTitle": {
            "type": "string"
          },
          "requesterLat": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "requesterLng": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "repLat": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "repLng": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "etaMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "distanceMiles": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "tier": {
            "type": "string"
          },
          "repState": {
            "type": "string"
          }
        }
      },
      "ActiveRequestLocationDto": {
        "required": [
          "lat",
          "lng"
        ],
        "type": "object",
        "properties": {
          "lat": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "lng": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "ActiveServiceRequestDto": {
        "required": [
          "requestId",
          "requesterName",
          "tier",
          "dtcTitle",
          "status",
          "assignedRepId",
          "assignedRepName",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "requesterName": {
            "type": "string"
          },
          "tier": {
            "type": "string"
