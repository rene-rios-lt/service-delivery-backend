  "components": {
    "schemas": {
      "LoginCommand": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RedirectRepRequest": {
        "required": [
          "repId",
          "toRequestId"
        ],
        "type": "object",
        "properties": {
          "repId": {
            "type": "string",
            "format": "uuid"
          },
          "toRequestId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SubmitServiceRequestBody": {
        "required": [
          "dtcId",
          "latitude",
          "longitude"
        ],
        "type": "object",
        "properties": {
          "dtcId": {
            "type": "string",
            "format": "uuid"
          },
          "latitude": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "longitude": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "UpdateVehiclePositionRequest": {
        "required": [
          "latitude",
          "longitude",
          "timestamp"
        ],
        "type": "object",
        "properties": {
          "latitude": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "longitude": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
